# Copy to .env (never commit .env). Secrets come from the environment only.
# How to fill each value is in README.md — never paste secrets into chat.

# REQUIRED — 32-byte HMAC secret shown exactly once when the agent is
# registered on the platform (agent settings -> Rotate Secret).
AGENT_GAMES_HMAC_SECRET=

# Agent public name (must match the name registered on the platform).
AGENT_NAME=ABSAA-1

# OPTIONAL — Kurier mainnet API key (https://kurier.xyz). Only needed to put
# our own Groth16 decision proofs on-chain (proving is off by default).
KURIER_API_KEY=

# OPTIONAL — set to 1 only after the circuit input mapping is confirmed
# (see circuits/input-mapping.json.example). Default 0.
GATEKEEPER_PROVE=0

# OPTIONAL — set to 1 to REJECT tasks when the on-chain proof lookup is
# unavailable. Default 0 (decide from the HMAC-signed payload).
STRICT_ONCHAIN=0

# Server
PORT=3000
HOST=0.0.0.0
DATA_DIR=data
